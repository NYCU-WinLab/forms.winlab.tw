# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.5

# Admin email allowlist — comma-separated. Only these emails can sign in;
# `scripts/provision-admin.ts` also refuses to provision any email not here.
ADMIN_EMAILS=loki@winlab.tw

# One-shot — only set when running `bun scripts/provision-admin.ts`. Do not
# leave this exported in your shell session.
# ADMIN_PASSWORD=

# Signs short-lived form gate cookies (32+ char random string)
FORM_GATE_SECRET=replace-me-with-openssl-rand-base64-32
