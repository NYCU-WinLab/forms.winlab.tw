# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.5

# Admin email allowlist — comma-separated, magic-link OTP only sent to these
ADMIN_EMAILS=loki@winlab.tw

# Signs short-lived form gate cookies (32+ char random string)
FORM_GATE_SECRET=replace-me-with-openssl-rand-base64-32
